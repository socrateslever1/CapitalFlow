[
  {
    "id": "PAWI9yAAU5c0jNjr",
    "name": "CapitalFlow - Regua de Cobranca",
    "active": true,
    "nodes": [
      {
        "parameters": {
          "rule": {
            "interval": [
              {
                "field": "cronExpression",
                "expression": "0 8-18 * * *"
              }
            ]
          }
        },
        "id": "capitalflow-collection-schedule",
        "name": "Hourly Business Window",
        "type": "n8n-nodes-base.scheduleTrigger",
        "typeVersion": 1.2,
        "position": [
          -520,
          0
        ]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "https://hzchchbxkhryextaymkn.supabase.co/functions/v1/capitalflow-daily-collections",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "x-capitalflow-secret",
                "value": "={{ $env.CAPITALFLOW_N8N_SECRET }}"
              }
            ]
          },
          "sendBody": true,
          "contentType": "raw",
          "rawContentType": "application/json",
          "body": "={{ JSON.stringify({ profile_id: $env.CAPITALFLOW_PROFILE_ID, action: 'collect', dry_run: false }) }}",
          "options": {
            "timeout": 60000
          }
        },
        "id": "capitalflow-collect-due",
        "name": "Prepare Collections",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          -300,
          0
        ]
      },
      {
        "parameters": {
          "jsCode": "const messages = $json.messages || [];\nreturn messages.filter((item) => item.dispatch_id && item.chat_id && item.message).map((item) => ({ json: item }));"
        },
        "id": "capitalflow-expand-collections",
        "name": "Expand Messages",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          -80,
          0
        ]
      },
      {
        "parameters": {
          "url": "=http://waha:3000/api/contacts/check-exists",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [{ "name": "X-Api-Key", "value": "={{ $env.WAHA_API_KEY }}" }]
          },
          "sendQuery": true,
          "queryParameters": {
            "parameters": [
              {
                "name": "session",
                "value": "={{ $json.session }}"
              },
              {
                "name": "phone",
                "value": "={{ $json.chat_id.replace('@c.us', '') }}"
              }
            ]
          },
          "options": {
            "timeout": 15000
          }
        },
        "id": "daily-resolve-whatsapp-contact",
        "name": "Resolve WhatsApp Contact",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          140,
          0
        ]
      },
      {
        "parameters": {
          "jsCode": "const source = $('Expand Messages').item.json;\nconst contactValid = Boolean($json.numberExists && $json.chatId);\nreturn [{\n  json: {\n    ...source,\n    chat_id: contactValid ? $json.chatId : source.chat_id,\n    contact_valid: contactValid,\n    error: contactValid ? undefined : { message: `Numero nao existe no WhatsApp: ${source.chat_id}` }\n  }\n}];"
        },
        "id": "daily-attach-whatsapp-contact",
        "name": "Attach Resolved Contact",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          360,
          0
        ]
      },
      {
        "parameters": {
          "conditions": {
            "options": {
              "caseSensitive": true,
              "leftValue": "",
              "typeValidation": "strict",
              "version": 2
            },
            "conditions": [
              {
                "id": "daily-contact-valid-condition",
                "leftValue": "={{ $json.contact_valid }}",
                "rightValue": true,
                "operator": {
                  "type": "boolean",
                  "operation": "true",
                  "singleValue": true
                }
              }
            ],
            "combinator": "and"
          },
          "options": {}
        },
        "id": "daily-contact-valid-gate",
        "name": "Is WhatsApp Contact Valid",
        "type": "n8n-nodes-base.if",
        "typeVersion": 2,
        "position": [
          470,
          0
        ]
      },
      {
        "parameters": {
          "jsCode": "return $input.all().map((item) => ({ json: { ...item.json, ai_used: false } }));"
        },
        "id": "daily-collection-local-ai",
        "name": "Local AI Naturalize",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          580,
          0
        ]
      },
      {
        "parameters": {
          "jsCode": "const repair = (value) => String(value || '').normalize('NFC');\nconst corrupted = /(?:\\u00c3[\\u0080-\\u00bf]|\\u00c2[\\u0080-\\u00bf]|\\ufffd)/u;\nreturn $input.all().map((item) => {\n  const source = item.json || {};\n  const message = repair(source.message).trim();\n  if (message.length < 10 || message.length > 1800 || corrupted.test(message)) throw new Error('Mensagem bloqueada: codificacao invalida');\n  return { json: { ...source, message, ai_used: false } };\n});"
        },
        "id": "daily-collection-ai-guard",
        "name": "Guard Financial Facts",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          800,
          0
        ]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "http://waha:3000/api/sendText",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [{ "name": "X-Api-Key", "value": "={{ $env.WAHA_API_KEY }}" }]
          },
          "sendBody": true,
          "contentType": "raw",
          "rawContentType": "application/json",
          "body": "={{ JSON.stringify({ session: $json.session, chatId: $json.chat_id, text: $json.message }) }}",
          "options": {
