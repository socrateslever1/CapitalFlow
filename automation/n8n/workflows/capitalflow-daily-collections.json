          "body": "={{ (() => { const source = $json.dispatch_id ? $json : $('Guard Financial Facts').item.json; return JSON.stringify({ profile_id: $env.CAPITALFLOW_PROFILE_ID, action: 'ack', dispatch_id: source.dispatch_id, success: true }); })() }}",
          "options": {
