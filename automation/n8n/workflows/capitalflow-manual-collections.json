              },
              {
                "name": "phone",
                "value": "={{ $json.chat_id.replace('@c.us', '') }}"
              }
            ]
          },
          "options": {
            "timeout": 15000
          }
        },
        "id": "manual-resolve-whatsapp-contact",
        "name": "Resolve WhatsApp Contact",
        "type": "n8n-nodes-base.httpRequest",
