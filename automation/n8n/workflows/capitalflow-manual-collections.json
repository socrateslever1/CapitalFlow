          0
        ],
        "onError": "continueRegularOutput"
      },
      {
        "parameters": {
          "conditions": {
            "options": {
              "caseSensitive": true,
              "leftValue": "",
              "typeValidation": "strict",
              "version": 2
            },
            "conditions": [
              {
                "id": "manual-has-pending-condition",
                "leftValue": "={{ Array.isArray($json.messages) && $json.messages.length > 0 }}",
                "rightValue": true,
                "operator": {
                  "type": "boolean",
                  "operation": "true",
                  "singleValue": true
                }
              }
            ],
            "combinator": "and"
          },
          "options": {}
        },
        "id": "manual-has-pending-gate",
        "name": "Has Pending Collections",
        "type": "n8n-nodes-base.if",
        "typeVersion": 2,
        "position": [
          -180,
          0
        ]
      },
      {
        "parameters": {
          "jsCode": "return ($json.messages || []).filter((item) => item.queue_id && item.chat_id && item.message).map((item) => ({ json: item }));"
        },
        "id": "expand-manual-collections",
        "name": "Expand Pending Collections",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
