      {
        "parameters": {
          "jsCode": "const repair = (value) => String(value || '')\n  .replace(/Ã¡/g, 'á').replace(/Ã€/g, 'À').replace(/ÃÁ/g, 'Á').replace(/Ã©/g, 'é').replace(/Ã‰/g, 'É')\n  .replace(/Ãª/g, 'ê').replace(/ÃŠ/g, 'Ê').replace(/Ã£/g, 'ã').replace(/Ãƒ/g, 'Ã')\n  .replace(/Ãµ/g, 'õ').replace(/Ã•/g, 'Õ').replace(/Ã§/g, 'ç').replace(/Ã‡/g, 'Ç')\n  .replace(/Ã³/g, 'ó').replace(/Ã“/g, 'Ó').replace(/Ãº/g, 'ú').replace(/Ãš/g, 'Ú')\n  .replace(/Ã­/g, 'í').replace(/Ã/g, 'Í').replace(/Â /g, ' ').replace(/Â/g, '');\nconst corrupted = /(?:Ã.|Â.|�|ï¿½)/u;\nreturn $input.all().map((item) => {\n  const source = item.json || {};\n  const message = repair(source.message).trim();\n  if (message.length < 10 || message.length > 1800 || corrupted.test(message)) throw new Error('Mensagem bloqueada: codificacao invalida');\n  return { json: { ...source, message, ai_used: false } };\n});"
        },
