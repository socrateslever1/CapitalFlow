      {
        "parameters": {
          "jsCode": "const message = String($json.message || '').replace(/^\\[\\[CF_CUSTOM\\]\\]\\s*/, '').trim();\nif (message.length < 10) throw new Error('Mensagem personalizada invalida');\nreturn [{ json: { ...$json, message, ai_used: false, custom_message: true } }];"
        },
