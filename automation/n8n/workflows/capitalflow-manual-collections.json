        "position": [
          140,
          0
        ]
      },
      {
        "parameters": {
          "jsCode": "const source = $('Expand Pending Collections').item.json;\nconst contactValid = Boolean($json.numberExists && $json.chatId);\nreturn [{\n  json: {\n    ...source,\n    chat_id: contactValid ? $json.chatId : source.chat_id,\n    contact_valid: contactValid,\n    error: contactValid ? undefined : { message: `Numero nao existe no WhatsApp: ${source.chat_id}` }\n  }\n}];"
        },
