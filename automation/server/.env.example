# Copie este arquivo para ".env" (na mesma pasta) e preencha. NUNCA envie o .env para o GitHub.
# Guia: docs/SERVIDOR_NUVEM_COBRANCA.md

# Endereço do n8n na internet (um subdomínio seu apontado para o IP do servidor).
N8N_DOMAIN=automacao.seudominio.com.br

# Fuso horário dos agendamentos (o mesmo do seu computador hoje).
TZ=America/Manaus

# Acesso ao painel do n8n pelo navegador.
PAINEL_USUARIO=admin
# Gere o hash com: docker run --rm caddy:2.8.4-alpine caddy hash-password --plaintext 'SUA_SENHA'
# Cole entre ASPAS SIMPLES (o hash contém "$").
PAINEL_SENHA_HASH='COLE_O_HASH_AQUI'

# Chave que protege as credenciais salvas no n8n. Gere com: openssl rand -hex 32
# Guarde uma cópia em local seguro: sem ela, as credenciais do n8n não abrem mais.
N8N_ENCRYPTION_KEY=

# Os mesmos valores usados hoje no n8n do seu computador (veja o guia, passo 4).
CAPITALFLOW_PROFILE_ID=
CAPITALFLOW_N8N_SECRET=
WAHA_API_KEY=

# Imagem do WAHA exatamente como aparece no seu computador (ex.: devlikeapro/waha:2024.10.8).
WAHA_IMAGE=

# Senha do Redis. Gere com: openssl rand -hex 24
REDIS_PASSWORD=

# Opcional: atendimento por WhatsApp. Deixe vazio enquanto o workflow de atendimento estiver desligado.
# Quando ligar: WAHA_HOOK_URL=http://n8n:5678/webhook/webhook
WAHA_HOOK_URL=
WAHA_HOOK_EVENTS=message
