{
  "name": "capitalflow-app",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "dev:tunnel": "npx -y localtunnel --port 3000",
    "build": "tsc -b && vite build",
    "build:skip-check": "vite build",
    "lint": "tsc -b",
    "preview": "vite preview",
    "test:financial": "tsx tests/financial/financial-invariants.ts",
    "test:financial-forgiveness": "node tests/financial/payment-forgiveness-order.test.mjs",
    "test:skills": "tsx tests/skills/skills.test.ts",
    "test:tools": "tsx tests/tools/tools.test.ts",
    "test:mcp": "tsx tests/mcp/mcp.test.ts",
    "test:evals": "tsx ai/evals/run.ts",
    "test:architecture": "node tests/architecture/architecture-check.mjs",
    "test:automation": "node --test automation/n8n/*.test.cjs",
    "test:ui-copy": "node tests/architecture/ui-copy-check.mjs",
    "test:quality": "npm run build && npm run test:financial && npm run test:financial-forgiveness && npm run test:skills && npm run test:tools && npm run test:mcp && npm run test:evals && npm run test:architecture && npm run test:ui-copy && npm run test:automation && npm run test:android-workflow && npm run test:wallet-module && npm run test:wallet-overview && npm run test:wallet-pages && npm run test:wallet-overview-localization && npm run test:wallet-card-opening && npm run test:app-updates && npm run test:auth-mobile-layout && npm run test:native-navigation && npm run test:ledger-presentation && npm run test:tablet-layout && npm run test:wallet-money-apk && npm run test:native-apk-update && npm run test:wallet-visual && npm run test:wallet-statement-import && npm run test:wallet-visual-next && npm run test:wallet-import-contract && npm run test:wallet-visual-simplification && npm run test:wallet-loading && npm run test:wallet-fast-path && npm run test:wallet-onboarding-schema && npm run test:wallet-native-inbox && npm run test:wallet-receipts && npm run test:android-release-resilience",
    "test:db": "node tests/db/run-local-db-tests.mjs",
    "test:load": "k6 run tests/load/app-smoke.js",
    "test:android-workflow": "node --test tests/architecture/android-workflow.test.mjs",
    "test:wallet-module": "node --test tests/architecture/wallet-module-hardening.test.mjs",
    "test:wallet-overview": "tsx --test tests/architecture/wallet-overview.test.mjs tests/wallet/card-summary-navigation.test.ts",
    "test:wallet-pages": "node --test tests/architecture/wallet-pages.test.mjs",
    "test:wallet-overview-localization": "node --test tests/architecture/wallet-overview-localization.test.mjs",
    "test:wallet-card-opening": "node --test tests/architecture/wallet-card-opening.test.mjs",
    "test:wallet-invoice-cycle": "tsx --test tests/wallet/invoice-cycle-state.test.ts",
    "test:wallet-capital-sync": "node --test tests/wallet/wallet-capital-sync.test.mjs",
    "test:wallet": "tsx --test --test-concurrency=1 tests/wallet/*.test.ts tests/wallet/*.test.tsx && node --test --test-concurrency=1 tests/wallet/*.test.mjs",
    "test:app-updates": "tsx --test tests/architecture/app-updates.test.ts",
    "test:auth-mobile-layout": "node --test tests/architecture/auth-mobile-layout.test.mjs",
    "test:native-navigation": "tsx --test tests/architecture/native-back-and-insets.test.ts",
    "test:ledger-presentation": "tsx --test tests/financial/ledger-presentation.test.ts",
    "test:tablet-layout": "node --test tests/architecture/tablet-card-focus-icon.test.mjs",
    "test:wallet-money-apk": "tsx --test tests/wallet/wallet-money-input.test.ts",
    "test:native-apk-update": "node --test tests/architecture/android-native-update.test.mjs",
    "test:wallet-visual": "node --test tests/architecture/wallet-visual-guard.test.mjs",
    "test:wallet-statement-import": "tsx --test tests/wallet/statement-smart-reader.test.ts tests/wallet/wallet-statement-pdf-categories.test.ts tests/wallet/wallet-statement-import-regression.test.ts tests/wallet/card-invoice-summary.test.ts tests/wallet/wallet-statement-duplicates.test.ts",
    "test:wallet-visual-next": "tsx --test tests/wallet/wallet-spending-insights.test.ts tests/wallet/wallet-summary-render.test.tsx tests/wallet/wallet-ui-architecture.test.ts",
    "test:wallet-import-contract": "node --test tests/architecture/wallet-import-contract.test.mjs",
    "test:wallet-visual-simplification": "node --test tests/architecture/wallet-visual-simplification.test.mjs",
    "test:wallet-loading": "tsx --test tests/wallet/wallet-loading-optimization.test.ts",
    "test:wallet-fast-path": "tsx --test tests/wallet/wallet-overview-fast-path.test.ts",
    "test:wallet-onboarding-schema": "tsx --test tests/wallet/wallet-onboarding-schema.test.ts",
    "test:wallet-native-inbox": "tsx --test tests/wallet/wallet-native-file-inbox.test.ts",
    "test:wallet-receipts": "tsx --test tests/wallet/wallet-quick-receipts.test.ts",
    "test:android-release-resilience": "node --test tests/architecture/android-release-resilience.test.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^7.1.0",
    "@capacitor/core": "^7.0.0",
    "@google/genai": "^1.34.0",
    "@modelcontextprotocol/server": "^2.2.0",
    "@supabase/supabase-js": "2.110.7",
    "@tinymce/tinymce-react": "^6.3.0",
    "@types/express": "^5.0.6",
    "@types/react-signature-canvas": "^1.0.7",
    "dexie": "^4.4.2",
    "dexie-react-hooks": "^4.4.0",
    "dompurify": "^3.4.12",
    "dotenv": "^17.3.1",
    "exceljs": "4.4.0",
    "express": "^5.2.1",
    "framer-motion": "^12.38.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.562.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router-dom": "^7.13.1",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "recharts": "^3.6.0",
    "sonner": "^2.0.7",
    "tinymce": "^8.3.2",
    "zod": "^4.6.5",
    "pdfjs-dist": "5.4.296"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.2.1",
    "tsx": "4.23.15",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
