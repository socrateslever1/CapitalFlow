{
  "name": "capitalflow-app",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "dev:tunnel": "npx -y localtunnel --port 3000",
    "build": "tsc -b && vite build",
    "build:skip-check": "vite build",
    "lint": "tsc -b",
    "preview": "vite preview",
    "test:financial": "tsx tests/financial/financial-invariants.ts",
    "test:financial-forgiveness": "node tests/financial/payment-forgiveness-order.test.mjs",
    "test:skills": "tsx tests/skills/skills.test.ts",
    "test:tools": "tsx tests/tools/tools.test.ts",
    "test:mcp": "tsx tests/mcp/mcp.test.ts",
    "test:evals": "tsx ai/evals/run.ts",
    "test:architecture": "node tests/architecture/architecture-check.mjs",
    "test:automation": "node --test automation/n8n/*.test.cjs",
    "test:ui-copy": "node tests/architecture/ui-copy-check.mjs",
    "test:quality": "npm run build && npm run test:financial && npm run test:financial-forgiveness && npm run test:skills && npm run test:tools && npm run test:mcp && npm run test:evals && npm run test:architecture && npm run test:ui-copy && npm run test:automation && npm run test:android-workflow && npm run test:wallet-module && npm run test:wallet-overview && npm run test:wallet-pages && npm run test:wallet-overview-localization && npm run test:wallet-card-opening && npm run test:app-updates && npm run test:auth-mobile-layout",
    "test:db": "node tests/db/run-local-db-tests.mjs",
    "test:load": "k6 run tests/load/app-smoke.js",
    "test:android-workflow": "node --test tests/architecture/android-workflow.test.mjs",
    "test:wallet-module": "node --test tests/architecture/wallet-module-hardening.test.mjs",
    "test:wallet-overview": "tsx --test tests/architecture/wallet-overview.test.mjs tests/wallet/card-summary-navigation.test.ts",
    "test:wallet-pages": "node --test tests/architecture/wallet-pages.test.mjs",
    "test:wallet-overview-localization": "node --test tests/architecture/wallet-overview-localization.test.mjs",
    "test:wallet-card-opening": "node --test tests/architecture/wallet-card-opening.test.mjs",
    "test:wallet-invoice-cycle": "tsx --test tests/wallet/invoice-cycle-state.test.ts",
    "test:app-updates": "tsx --test tests/architecture/app-updates.test.ts",
    "test:auth-mobile-layout": "node --test tests/architecture/auth-mobile-layout.test.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.34.0",
    "@modelcontextprotocol/server": "^2.2.0",
    "@supabase/supabase-js": "2.110.7",
    "@tinymce/tinymce-react": "^6.3.0",
    "@types/express": "^5.0.6",
    "@types/react-signature-canvas": "^1.0.7",
    "dexie": "^4.4.2",
    "dexie-react-hooks": "^4.4.0",
    "dompurify": "^3.4.12",
    "dotenv": "^17.3.1",
    "exceljs": "4.4.0",
    "express": "^5.2.1",
    "framer-motion": "^12.38.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.562.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router-dom": "^7.13.1",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "recharts": "^3.6.0",
    "sonner": "^2.0.7",
    "tinymce": "^8.3.2",
    "zod": "^4.6.5",
    "pdfjs-dist": "5.4.296"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.2.1",
    "tsx": "4.23.15",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
