/index.html
  Cache-Control: no-store, no-cache, must-revalidate

/404.html
  Cache-Control: no-store, no-cache, must-revalidate

/version.json
  Cache-Control: no-store, no-cache, must-revalidate
  Content-Type: application/json; charset=utf-8

/service-worker.js
  Cache-Control: no-store, no-cache, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable
